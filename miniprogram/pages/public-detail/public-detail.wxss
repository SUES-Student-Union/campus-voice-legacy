.public-detail { padding-top: 24rpx; }
.desensitized-banner { display: flex; align-items: center; padding: 20rpx; background: #eaf2fd; color: #49627f; border-radius: 12rpx; }
.privacy-icon { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 16rpx; background: #246bce; color: #fff; border-radius: 8rpx; font-size: 22rpx; font-weight: 700; }
.privacy-title { color: #284c78; font-size: 24rpx; font-weight: 700; }
.privacy-copy { margin-top: 4rpx; font-size: 21rpx; }
.detail-head { margin-top: 20rpx; padding: 28rpx; }
.head-top { display: flex; align-items: center; justify-content: space-between; }
.category-label { color: #176b5b; font-size: 24rpx; font-weight: 700; }
.detail-title { margin-top: 22rpx; font-size: 38rpx; line-height: 54rpx; font-weight: 750; }
.detail-summary { margin-top: 14rpx; color: #66736f; font-size: 25rpx; line-height: 42rpx; }
.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx 24rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 2rpx solid #e9eeec; color: #35413e; font-size: 23rpx; }
.meta-grid view { display: flex; flex-direction: column; min-width: 0; }
.meta-label { margin-bottom: 7rpx; color: #929d99; font-size: 20rpx; }
.public-reply { padding: 28rpx; border-left: 6rpx solid #176b5b; }
.reply-org { color: #176b5b; font-size: 24rpx; font-weight: 700; }
.reply-content { margin-top: 18rpx; color: #35413e; font-size: 28rpx; line-height: 48rpx; }
.reply-audit { margin-top: 20rpx; color: #929d99; font-size: 21rpx; }
.timeline-card { padding: 28rpx 24rpx 4rpx; }
.timeline-item { display: flex; }
.timeline-axis { position: relative; flex: 0 0 34rpx; display: flex; flex-direction: column; align-items: center; }
.timeline-dot { z-index: 1; width: 18rpx; height: 18rpx; margin-top: 7rpx; background: #7db7aa; border: 5rpx solid #e8f3f0; border-radius: 50%; }
.timeline-dot.current { background: #176b5b; border-color: #c9e3dd; }
.timeline-line { position: absolute; top: 30rpx; bottom: -8rpx; width: 2rpx; background: #dce3e0; }
.timeline-body { flex: 1; padding: 0 0 34rpx 18rpx; }
.timeline-head { display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 700; }
.timeline-time { color: #929d99; font-size: 21rpx; font-weight: 400; }
.timeline-operator { margin-top: 7rpx; color: #176b5b; font-size: 22rpx; }
.timeline-desc { margin-top: 8rpx; color: #66736f; font-size: 24rpx; line-height: 38rpx; }
.public-footer { padding: 44rpx 12rpx 18rpx; color: #929d99; font-size: 21rpx; line-height: 34rpx; text-align: center; }
