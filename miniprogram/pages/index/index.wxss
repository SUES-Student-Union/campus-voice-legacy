page { height: 100%; }
.scrollarea { height: 100%; }
.home-page { padding-top: 32rpx; }
.brand-row { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow { color: #66736f; font-size: 22rpx; line-height: 34rpx; }
.brand-title { margin-top: 8rpx; font-size: 50rpx; line-height: 66rpx; font-weight: 800; letter-spacing: 2rpx; }
.brand-copy { margin-top: 6rpx; color: #176b5b; font-size: 26rpx; font-weight: 600; }
.service-badge { display: flex; align-items: center; margin-top: 8rpx; padding: 10rpx 16rpx; background: #e8f5ee; color: #23855b; border-radius: 8rpx; font-size: 22rpx; }
.online-dot { width: 12rpx; height: 12rpx; margin-right: 8rpx; background: #23855b; border-radius: 50%; }
.notice-strip { display: flex; align-items: center; margin: 30rpx 0 24rpx; padding: 20rpx 22rpx; background: #fffaf1; border-left: 6rpx solid #b76808; border-radius: 8rpx; }
.notice-label { flex: 0 0 auto; margin-right: 18rpx; color: #9b5608; font-size: 22rpx; font-weight: 700; }
.notice-text { color: #5e5140; font-size: 24rpx; line-height: 36rpx; }
.main-action { display: flex; align-items: center; min-height: 152rpx; padding: 28rpx 28rpx; box-sizing: border-box; background: #176b5b; color: #fff; border-radius: 16rpx; }
.action-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 22rpx; background: rgba(255,255,255,.16); border: 2rpx solid rgba(255,255,255,.36); border-radius: 12rpx; font-size: 42rpx; font-weight: 300; }
.action-body { flex: 1; }
.action-title { font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.action-desc { margin-top: 4rpx; color: rgba(255,255,255,.76); font-size: 24rpx; }
.action-arrow { font-size: 48rpx; font-weight: 300; }
.secondary-grid { display: flex; gap: 20rpx; margin-top: 20rpx; }
.secondary-action { flex: 1; min-height: 210rpx; padding: 26rpx; }
.secondary-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; color: #176b5b; background: #e8f3f0; border-radius: 10rpx; font-size: 24rpx; font-weight: 700; }
.secondary-icon.light { color: #246bce; background: #eaf2fd; }
.secondary-title { margin-top: 24rpx; font-size: 30rpx; font-weight: 700; }
.secondary-desc { margin-top: 8rpx; color: #66736f; font-size: 23rpx; line-height: 34rpx; }
.overview-row { display: flex; align-items: center; padding: 28rpx 0; background: #fff; border: 2rpx solid #e3e9e6; border-radius: 16rpx 16rpx 0 0; }
.overview-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.overview-value { font-size: 38rpx; line-height: 52rpx; font-weight: 750; }
.overview-label { margin-top: 2rpx; color: #66736f; font-size: 22rpx; }
.overview-divider { width: 2rpx; height: 48rpx; background: #e9eeec; }
.latest-card { margin-top: -2rpx; padding: 26rpx; border-radius: 0 0 16rpx 16rpx; }
.latest-top { display: flex; align-items: center; justify-content: space-between; }
.issue-number { color: #66736f; font-size: 22rpx; font-family: monospace; }
.latest-title { margin-top: 20rpx; font-size: 30rpx; line-height: 44rpx; font-weight: 700; }
.latest-progress { margin-top: 14rpx; padding: 16rpx 18rpx; background: #f5f7f6; color: #35413e; border-radius: 8rpx; font-size: 24rpx; line-height: 38rpx; }
.latest-meta { margin-top: 16rpx; color: #929d99; font-size: 22rpx; }
.faq-list { overflow: hidden; }
.guide-list { overflow: hidden; }
.guide-item { display: flex; align-items: center; min-height: 100rpx; padding: 0 24rpx; }
.guide-item + .guide-item { border-top: 2rpx solid #e9eeec; }
.guide-tag { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 52rpx; margin-right: 18rpx; background: #e8f3f0; color: #176b5b; border-radius: 8rpx; font-size: 21rpx; font-weight: 700; }
.guide-body { flex: 1; color: #35413e; font-size: 26rpx; font-weight: 600; }
.guide-body text { display: block; margin-top: 5rpx; color: #929d99; font-size: 20rpx; font-weight: 400; }
.guide-arrow { color: #929d99; font-size: 36rpx; }
.faq-item { padding: 0 24rpx; }
.faq-item + .faq-item { border-top: 2rpx solid #e9eeec; }
.faq-question { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; font-size: 27rpx; font-weight: 600; }
.faq-toggle { color: #176b5b; font-size: 36rpx; font-weight: 400; }
.faq-answer { padding: 0 40rpx 24rpx 0; color: #66736f; font-size: 24rpx; line-height: 40rpx; }
.privacy-note { padding: 48rpx 20rpx 20rpx; color: #929d99; font-size: 22rpx; line-height: 34rpx; text-align: center; }

.identity-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.identity-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.identity-title {
  font-size: 30rpx;
  font-weight: 700;
}

.identity-sub {
  margin-top: 4rpx;
  color: #66736f;
  font-size: 22rpx;
}

.admin-btn {
  color: #176b5b;
  font-size: 24rpx;
}

.identity-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.identity-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #e9eeec;
  color: #66736f;
  font-size: 24rpx;
}

.identity-chip.active {
  background: #176b5b;
  color: #fff;
  font-weight: 650;
}
