page {
  background: #f5f7f6;
}

.review-page {
  padding: 24rpx 32rpx 48rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 750;
  line-height: 56rpx;
}

.page-copy {
  margin-top: 6rpx;
  color: #66736f;
  font-size: 24rpx;
  line-height: 36rpx;
}

.case-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.case-card {
  padding: 24rpx;
}

.case-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.issue-id {
  color: #929d99;
  font-size: 22rpx;
}

.case-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 42rpx;
}

.case-meta {
  margin-top: 10rpx;
  color: #66736f;
  font-size: 22rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.origin-card,
.draft-card {
  padding: 24rpx;
}

.origin-row {
  display: flex;
  flex-direction: column;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 40rpx;
}

.origin-row text:first-child {
  color: #929d99;
  font-size: 21rpx;
}

.draft-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 4rpx;
  border-bottom: 2rpx solid #eef1f0;
  font-size: 27rpx;
}

.draft-textarea,
.note-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  margin-top: 16rpx;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid #eef1f0;
  font-size: 27rpx;
  line-height: 40rpx;
}

.review-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
  border-radius: 12rpx;
  margin: 0;
  background: #fff;
  border: 2rpx solid #dce3e0;
  color: #35413e;
}

.action-btn.primary {
  background: #176b5b;
  color: #fff;
  border-color: #176b5b;
}

.action-btn.danger {
  color: #a62d22;
  border-color: #f3c7c3;
}

.reject-hint {
  margin-top: 20rpx;
}

.note-textarea {
  border: 2rpx solid #dce3e0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  min-height: 120rpx;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
  color: #66736f;
}

.empty-title {
  font-size: 28rpx;
}
