page {
  background: #f5f7f6;
}

.logs-page {
  padding: 24rpx 32rpx 48rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 750;
  line-height: 56rpx;
}

.page-copy {
  margin-top: 6rpx;
  color: #66736f;
  font-size: 24rpx;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.log-card {
  padding: 24rpx;
}

.log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-action {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf2fd;
  color: #246bce;
  font-size: 22rpx;
  font-weight: 600;
}

.log-time {
  color: #929d99;
  font-size: 22rpx;
}

.log-operator {
  margin-top: 12rpx;
  color: #35413e;
  font-size: 24rpx;
}

.log-change {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}

.log-before {
  color: #929d99;
}

.log-arrow {
  color: #c4cfcb;
}

.log-after {
  color: #176b5b;
  font-weight: 650;
}

.log-detail {
  margin-top: 10rpx;
  color: #66736f;
  font-size: 23rpx;
  line-height: 36rpx;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
  color: #66736f;
}

.empty-title {
  font-size: 28rpx;
}
