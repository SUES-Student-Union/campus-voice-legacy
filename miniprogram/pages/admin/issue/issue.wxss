page {
  background: #f5f7f6;
}

.admin-issue {
  padding: 24rpx 32rpx 48rpx;
}

.head-card {
  padding: 24rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.issue-no {
  color: #929d99;
  font-size: 22rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 24rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #eef1f0;
}

.meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta text:first-child {
  color: #929d99;
  font-size: 21rpx;
}

.meta text:last-child {
  color: #35413e;
  font-size: 25rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.content-card {
  padding: 24rpx;
  color: #35413e;
  font-size: 27rpx;
  line-height: 44rpx;
}

.timeline-card {
  padding: 24rpx 0 24rpx 24rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #c4cfcb;
  flex: none;
}

.timeline-dot.current {
  background: #176b5b;
}

.timeline-body {
  flex: 1;
  padding-bottom: 24rpx;
}

.timeline-head {
  display: flex;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 650;
}

.timeline-time {
  color: #929d99;
  font-size: 22rpx;
  font-weight: 400;
}

.timeline-operator {
  margin-top: 4rpx;
  color: #66736f;
  font-size: 22rpx;
}

.timeline-desc {
  margin-top: 6rpx;
  color: #35413e;
  font-size: 24rpx;
  line-height: 36rpx;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid #dce3e0;
  color: #35413e;
  margin: 0;
}

.action-btn.primary {
  background: #176b5b;
  color: #fff;
  border-color: #176b5b;
}

.action-btn.danger {
  color: #a62d22;
  border-color: #f3c7c3;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(12, 28, 24, 0.5);
}

.sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.sheet-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 2rpx solid #eef1f0;
  font-size: 27rpx;
}

.sheet-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #dce3e0;
  border-radius: 12rpx;
  font-size: 27rpx;
}

.sheet-submit {
  margin-top: 28rpx;
  width: 100%;
}
