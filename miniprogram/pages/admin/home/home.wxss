page {
  background: #f5f7f6;
}

.admin-home {
  padding: 24rpx 32rpx 48rpx;
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.home-title {
  font-size: 40rpx;
  font-weight: 750;
  line-height: 56rpx;
}

.home-sub {
  margin-top: 6rpx;
  color: #66736f;
  font-size: 24rpx;
}

.logout-btn {
  padding: 10rpx 22rpx;
  border: 2rpx solid #dce3e0;
  border-radius: 10rpx;
  color: #a62d22;
  font-size: 24rpx;
}

.stats-card {
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.stats-row {
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 750;
  color: #176b5b;
}

.stat-label {
  margin-top: 6rpx;
  color: #66736f;
  font-size: 22rpx;
}

.stat-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #eef1f0;
  color: #66736f;
  font-size: 22rpx;
  text-align: center;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f3f0;
  color: #176b5b;
  font-size: 30rpx;
  font-weight: 700;
}

.menu-body {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 650;
}

.menu-desc {
  margin-top: 6rpx;
  color: #66736f;
  font-size: 22rpx;
}

.menu-arrow {
  color: #929d99;
  font-size: 34rpx;
}
